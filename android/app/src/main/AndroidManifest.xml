<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Uygulamanın indirdiği yeni sürümü Android'in kurulum ekranına verebilmesi için. Kurulumu her seferinde kullanıcı onaylar. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_klavuz"
        android:roundIcon="@drawable/ic_klavuz"
        android:label="Klavuz"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Klavuz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Başka uygulamalardan (tarayıcı, alışveriş uygulamaları) "paylaş" ile ürün bağlantısı almak için -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- İndirilen güncelleme dosyasını yalnız kurulum ekranına açar -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hcmarinworks.klavuz.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
